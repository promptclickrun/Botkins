#!/bin/bash
# Manages the Botkins server the Azure one-click deployment installed.
#   botkins pair      open a new pairing code and print its link
#   botkins link      print the open pairing link, if there is one
#   botkins status    show the containers, and the server's own status
#   botkins logs      follow the logs
#   botkins update    fetch the latest sources, rebuild and restart
#   botkins compose … run docker compose on this deployment
#
# Without Screen access the server is the terminal host, and these work too:
#   botkins host …          run the terminal host's own command (docs/terminal.md), for example
#                           `botkins host providers login copilot` or `botkins host bots list`
#   botkins install-claude  install Claude Code for the server, so it can use a Claude plan
# A command this file does not know goes to the terminal host as it is: `botkins devices list`.
set -euo pipefail
SRC=/opt/botkins/src
ENV=/etc/botkins/botkins.env
# Where the terminal host's open pairing link is kept: memory only, and root's alone.
OPEN=/run/botkins/pairing

usage() { sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'; }
case "${1:-}" in help | --help | -h) usage; exit 0 ;; esac
[ -r "$ENV" ] || { echo "botkins: run this as root (sudo botkins ${1:-status})." >&2; exit 77; }

# One setting from the deployment's file. Values are not quoted there, so it is not sourced.
setting() { sed -n "s/^$1=//p" "$ENV" | head -n 1; }
FQDN=$(setting BOTKINS_FQDN)
# A deployment made before there were two setups has no mode: it is the one with a screen.
MODE=$(setting BOTKINS_MODE)
if [ "$MODE" = terminal ]; then PROFILE=terminal; else MODE=screen; PROFILE=display; fi

compose() {
  docker compose --project-directory "$SRC/desktop" --env-file "$ENV" --profile "$PROFILE" \
    -f "$SRC/desktop/docker-compose.yml" -f "$SRC/deploy/azure/docker-compose.azure.yml" "$@"
}

# ── The terminal host ─────────────────────────────────────────────────────────────────────────

# The terminal host's own command line, inside its container. It gets a terminal when there is one.
host() {
  if [ -t 0 ] && [ -t 1 ]; then compose exec botkins botkins "$@"; else compose exec -T botkins botkins "$@"; fi
}
terminal_ready() { compose exec -T botkins botkins status --json >/dev/null 2>&1; }
terminal_connected() {
  compose exec -T botkins botkins relay status --json 2>/dev/null |
    python3 -c 'import json, sys; sys.exit(0 if json.load(sys.stdin).get("connected") else 1)' 2>/dev/null
}
# Opens a code and prints its web link. Phones come through the relay only, so the link offers
# the relay and leaves out the container's own address, which no phone can reach.
terminal_pair() {
  # The same setting the Screen access host reads, in milliseconds. An hour unless it says otherwise.
  local ms minutes=60
  ms=$(setting BOTKINS_PAIR_TTL_MS)
  case "$ms" in "" | *[!0-9]*) ;; *) minutes=$((ms / 60000)) ;; esac
  [ "$minutes" -ge 1 ] && [ "$minutes" -le 1440 ] || minutes=60
  install -d -m 0700 "$(dirname "$OPEN")"
  compose exec -T botkins botkins pair --ttl "$minutes" --no-wait --json | (umask 077; python3 -c '
import json, sys
from urllib.parse import parse_qsl, urlencode, urlsplit
fqdn, keep = sys.argv[1], sys.argv[2]
pairing = json.load(sys.stdin)
query = parse_qsl(urlsplit(pairing["url"]).query, keep_blank_values=True)
relays = [entry for name, value in query if name == "h" for entry in value.split(",") if entry.startswith("relay!")]
if not relays: sys.exit("The pairing code has no relay address.")
link = "https://" + fqdn + "/pair#" + urlencode([(name, ",".join(relays) if name == "h" else value) for name, value in query])
with open(keep, "w") as file: json.dump({"link": link, "code": pairing["code"], "expiresAt": pairing["expiresAt"]}, file)
print(link)' "$FQDN" "$OPEN")
}
# The link `botkins pair` last printed, while a code is still open and that link has not run out.
terminal_link() {
  [ -f "$OPEN" ] || return 1
  compose exec -T botkins botkins status --json 2>/dev/null | python3 -c '
import json, sys
from datetime import datetime, timezone
status = json.load(sys.stdin)
with open(sys.argv[1]) as file: kept = json.load(file)
open_now = status.get("link", {}).get("pairing") and status.get("relay", {}).get("connected")
if not open_now or datetime.fromisoformat(kept["expiresAt"].replace("Z", "+00:00")) <= datetime.now(timezone.utc): sys.exit(1)
print(kept["link"])' "$OPEN" 2>/dev/null
}

# ── Screen access: the host and workspace containers ──────────────────────────────────────────

# The open pairing, as the host container keeps it.
screen_pairing() { compose exec -T host cat /run/botkins-owner/pairing.json 2>/dev/null; }
# Whether the host process has started and listens for SIGUSR2 (it logs this line after that).
screen_ready() {
  local id started
  id=$(compose ps -q host 2>/dev/null) && [ -n "$id" ] || return 1
  started=$(docker inspect -f '{{.State.StartedAt}}' "$id") || return 1
  docker logs --since "$started" "$id" 2>&1 | grep -q 'is listening on port'
}
screen_link() {
  screen_pairing | python3 -c '
import json, sys
p = json.load(sys.stdin)
if p.get("link") and (p.get("relay") or {}).get("connected"): print(p["link"])
else: sys.exit(1)' 2>/dev/null
}

# ──────────────────────────────────────────────────────────────────────────────────────────────

case "${1:-}" in
  pair)
    # Waits (up to --wait seconds, default 20) for the server to start and reach its relay.
    wait=20
    [ "${2:-}" = "--wait" ] && wait="${3:-600}"
    end=$((SECONDS + wait))
    main=$([ "$MODE" = terminal ] && echo botkins || echo host)
    until "${MODE}_ready"; do
      [ $SECONDS -lt $end ] || { echo "The Botkins server isn't running. Check: botkins logs $main" >&2; exit 1; }
      sleep 2
    done
    if [ "$MODE" = terminal ]; then
      until terminal_connected; do
        [ $SECONDS -lt $end ] || { echo "The server hasn't reached its relay yet. Check: botkins logs caddy relay botkins" >&2; exit 1; }
        sleep 2
      done
      terminal_pair
    else
      compose kill -s SIGUSR2 host >/dev/null
      until screen_link; do
        [ $SECONDS -lt $end ] || { echo "The server hasn't reached its relay yet. Check: botkins logs caddy relay host" >&2; exit 1; }
        sleep 2
      done
    fi
    ;;
  link) "${MODE}_link" || { echo "No pairing link is open. Run: botkins pair" >&2; exit 1; } ;;
  status)
    compose ps
    if [ "$MODE" = terminal ] && terminal_ready; then echo; compose exec -T botkins botkins status; fi
    ;;
  logs) shift; compose logs -f --tail=200 "$@" ;;
  update)
    git -C "$SRC" fetch -q --depth 1 origin "${2:-main}"
    git -C "$SRC" checkout -q --force FETCH_HEAD
    install -m 0755 "$SRC/deploy/azure/botkins" /usr/local/bin/botkins
    # The rest runs from the new copy of this file.
    exec /usr/local/bin/botkins restart-updated
    ;;
  restart-updated)
    compose build
    compose up -d --remove-orphans
    ;;
  compose) shift; compose "$@" ;;
  "") usage; exit 64 ;;
  *)
    if [ "$MODE" != terminal ]; then
      echo "botkins: \`$1\` is a command of the terminal host. This server runs with Screen access: use the Botkins app on a paired phone." >&2
      exit 64
    fi
    case "$1" in
      host) shift; host "$@" ;;
      install-claude)
        # Into the service's own home, which is in the data volume: the image itself is read-only.
        compose exec -T botkins sh -c 'npm install -g --prefix "$HOME/.local" --no-audit --no-fund --loglevel=error @anthropic-ai/claude-code && "$HOME/.local/bin/claude" --version'
        ;;
      *) host "$@" ;;
    esac
    ;;
esac
