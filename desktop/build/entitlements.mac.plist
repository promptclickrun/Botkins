<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Electron's V8 needs JIT and unsigned executable memory under the hardened runtime. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- The bundled Copilot runtime is signed by GitHub's team, so library validation must allow other teams. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- The iMessage and Mail tools ask Messages and Mail to act (desktop/mactools.mjs). macOS asks the person first. -->
  <key>com.apple.security.automation.apple-events</key>
  <true/>
  <!-- Dictation through a speech service and live voice record from the microphone. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
