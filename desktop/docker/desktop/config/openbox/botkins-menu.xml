<?xml version="1.0" encoding="UTF-8"?>
<!--
  The right-click menu of a display Botkins starts itself. Each entry runs botkins-desktop-open,
  which botkins-desktop puts on PATH. The programs it opens (xdotool, xterm, mc) are installed
  with the display: desktop/Dockerfile and deploy/azure/install.sh.
-->
<openbox_menu xmlns="http://openbox.org/3.4/menu">
  <menu id="root-menu" label="Botkins">
    <item label="Open Botkins">
      <action name="Execute">
        <command>botkins-desktop-open botkins</command>
      </action>
    </item>
    <separator/>
    <item label="Terminal">
      <action name="Execute">
        <command>botkins-desktop-open terminal</command>
      </action>
    </item>
    <item label="Files">
      <action name="Execute">
        <command>botkins-desktop-open files</command>
      </action>
    </item>
  </menu>
</openbox_menu>
