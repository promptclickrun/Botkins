<?xml version="1.0" encoding="UTF-8"?>
<!--
  Application and window menu on the private desktop. The kit puts botkins-desktop-open on PATH.
-->
<openbox_menu xmlns="http://openbox.org/3.4/menu">
  <menu id="root-menu" label="Botkins">
    <item label="Open Botkins">
      <action name="Execute">
        <command>botkins-desktop-open botkins</command>
      </action>
    </item>
    <separator/>
    <item label="Terminal">
      <action name="Execute">
        <command>botkins-desktop-open terminal</command>
      </action>
    </item>
    <item label="Files">
      <action name="Execute">
        <command>botkins-desktop-open files</command>
      </action>
    </item>
    <item label="Browser">
      <action name="Execute">
        <command>botkins-desktop-open browser</command>
      </action>
    </item>
    <separator/>
    <menu id="client-list-combined-menu"/>
    <item label="Show desktop"><action name="ToggleShowDesktop"/></item>
  </menu>
</openbox_menu>
