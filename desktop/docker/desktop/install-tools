#!/bin/sh
# Installs the Linux programs used by the managed desktop. --check only probes availability.
set -eu
case ${1:-} in ""|--check) ;; *) echo "usage: install-tools [--check]" >&2; exit 64 ;; esac
system_path=/usr/sbin:/usr/bin:/sbin:/bin:/usr/local/sbin:/usr/local/bin:/opt/google/chrome:/run/current-system/sw/bin
if [ -x /usr/bin/id ]; then uid=$(/usr/bin/id -u); else uid=$(/run/current-system/sw/bin/id -u); fi
if [ "$uid" = 0 ]; then
  PATH=$system_path
else
  profile=$HOME/.local/share/botkins-desktop-tools
  PATH=$profile/bin:${PATH:-$system_path}:$HOME/.nix-profile/bin:/nix/var/nix/profiles/default/bin:$system_path
fi
export PATH
has() { for tool in "$@"; do command -v "$tool" >/dev/null 2>&1 && return 0; done; return 1; }
ready() {
  for tool in Xvfb xvfb-run xauth xdpyinfo xprop hsetroot openbox dbus-run-session xdotool ffmpeg; do has "$tool" || return 1; done
  has xterm lxterminal xfce4-terminal && has pcmanfm thunar mc && has google-chrome chromium chromium-browser firefox-esr firefox epiphany netsurf-gtk
}
if ready; then exit 0; fi
[ "${1:-}" != --check ] || exit 1
[ "${BOTKINS_DESKTOP:-auto}" != off ] || exit 0

# Nix can install the complete stack for a single user without sudo or system package changes.
if [ "$uid" != 0 ] && has nix; then
  mkdir -p "$(dirname "$profile")"
  if nix --extra-experimental-features 'nix-command flakes' profile install --profile "$profile" \
      nixpkgs#xvfb nixpkgs#xvfb-run nixpkgs#xauth nixpkgs#xdpyinfo nixpkgs#xprop \
      nixpkgs#hsetroot nixpkgs#openbox nixpkgs#dbus nixpkgs#xdotool nixpkgs#ffmpeg \
      nixpkgs#xterm nixpkgs#pcmanfm nixpkgs#chromium </dev/null && ready; then exit 0; fi
fi
admin() {
  if [ "$uid" = 0 ]; then /usr/bin/env -i PATH="$system_path" DEBIAN_FRONTEND=noninteractive "$@" </dev/null
  else /usr/bin/sudo -n -- "$@" </dev/null; fi
}
debian_packages="xvfb xauth x11-utils xdotool ffmpeg openbox hsetroot dbus-daemon xterm pcmanfm fonts-dejavu-core"
if [ "$uid" != 0 ] && [ ! -x /usr/bin/sudo ]; then
  echo "The private desktop needs Linux display packages. On Debian: sudo apt-get install $debian_packages chromium. A user-owned Nix profile also works." >&2
  exit 1
fi
if [ -x /usr/bin/apt-get ]; then
  # No user-selected script or downloaded file is ever passed to sudo.
  if ! admin /usr/bin/apt-get -o DPkg::Lock::Timeout=120 -o Acquire::Retries=2 update -q; then
    echo "To provision the desktop, have an administrator install $debian_packages and a browser, or install them with Nix." >&2
    exit 1
  fi
  browser=""
  if ! has google-chrome chromium chromium-browser firefox-esr firefox epiphany netsurf-gtk; then
    candidate() { LC_ALL=C /usr/bin/apt-cache policy "$1" | awk '$1 == "Candidate:" && $2 != "(none)" { found=1 } END { exit !found }'; }
    if candidate chromium; then browser=chromium
    elif candidate google-chrome-stable; then browser=google-chrome-stable
    else browser="epiphany-browser netsurf-gtk"; fi
  fi
  # Package lists are fixed above. All packages are verified by the system package manager.
  admin /usr/bin/apt-get -o DPkg::Lock::Timeout=120 install -y --no-install-recommends $debian_packages $browser
elif [ -x /usr/bin/dnf ]; then
  admin /usr/bin/dnf -y install /usr/bin/Xvfb /usr/bin/xvfb-run /usr/bin/xdpyinfo /usr/bin/xprop /usr/bin/xauth /usr/bin/dbus-run-session /usr/bin/ffmpeg xdotool hsetroot openbox xterm pcmanfm chromium
elif [ -x /usr/bin/pacman ]; then
  admin /usr/bin/pacman -S --needed --noconfirm xorg-server-xvfb xorg-xauth xorg-xdpyinfo xorg-xprop xdotool ffmpeg openbox hsetroot dbus xterm pcmanfm chromium ttf-dejavu
fi
if ! ready; then
  echo "The desktop needs Xvfb, xvfb-run, xauth, xdpyinfo, xprop, hsetroot, Openbox, dbus-run-session, xdotool, ffmpeg, a terminal, a file manager and a browser. Install them with your package manager, then restart Botkins." >&2
  exit 1
fi
