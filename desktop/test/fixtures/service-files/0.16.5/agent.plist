<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>app.botkins.terminal</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/botkins/current/bin/botkins</string>
    <string>serve</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>BOTKINS_DATA_DIR</key>
    <string>/Users/sam/Library/Application Support/Botkins Terminal</string>
    <key>BOTKINS_QUIET</key>
    <string>1</string>
    <key>NODE_ENV</key>
    <string>production</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/bin</string>
  </dict>
  <key>WorkingDirectory</key>
  <string>/Users/sam/Library/Application Support/Botkins Terminal</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>5</integer>
  <key>ExitTimeOut</key>
  <integer>20</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>Umask</key>
  <integer>63</integer>
  <key>StandardOutPath</key>
  <string>/Users/sam/Library/Application Support/Botkins Terminal/logs/launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/sam/Library/Application Support/Botkins Terminal/logs/launchd.log</string>
</dict>
</plist>
