{
  "manifest_version": 3,
  "name": "Botkins Browser Control",
  "short_name": "Botkins",
  "version": "0.2.0",
  "description": "Connect your signed-in Chrome or Edge profile to your Botkins hosts so your bots can browse and act for you even when you're away.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Botkins Browser Control",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "options_page": "options/options.html",
  "permissions": [
    "scripting",
    "debugger",
    "tabs",
    "tabGroups",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://profile.botkins.app/*",
    "https://relay.botkins.app/*",
    "http://127.0.0.1/*",
    "http://localhost/*",
    "http://*/*",
    "https://*/*"
  ]
}
