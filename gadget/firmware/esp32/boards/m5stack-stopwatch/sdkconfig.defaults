# M5Stack StopWatch (SKU C152): ESP32-S3R8 (16 MB flash, 8 MB octal PSRAM), round 1.75"
# 466x466 CO5300 AMOLED, one ES8311 codec, M5PM1 power manager and M5IOE1 I/O expander.
# The flash, PSRAM and console settings are the Hermes Gadget firmware's for this board
# (firmware/esp32/boards/m5stack-stopwatch/sdkconfig.defaults, MIT).
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# The USB-C port is the S3's own USB-Serial-JTAG; the console lives on it.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# TCP windows and Wi-Fi/lwIP buffers in PSRAM, as the Hermes firmware has them for replies' audio.
CONFIG_LWIP_TCP_WND_DEFAULT=32768
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=32768
CONFIG_LWIP_TCP_RECVMBOX_SIZE=32
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
