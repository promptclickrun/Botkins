# Every ESP32 board. A board adds its own in boards/<name>/sdkconfig.defaults.

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_APP_PROJECT_VER_FROM_CONFIG=y
CONFIG_APP_PROJECT_VER="0.1.0"

# The core is C++17 with std::thread, std::string and std::function; no exceptions or RTTI.
CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_COMPILER_CXX_RTTI=n
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# The core's threads (sync, work) are pthreads. app_main also sets this with
# esp_pthread_set_cfg before gadget.begin(); this is the default for threads made elsewhere.
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=16384
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

CONFIG_LOG_DEFAULT_LEVEL_INFO=y
# Each task's stack high-water mark, for the console's `tasks` line.
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_HZ=1000

# Wi-Fi: the port keeps the network in its own NVS namespace, so the driver's own copy
# is not written (esp_wifi_set_storage(WIFI_STORAGE_RAM) too).
CONFIG_ESP_WIFI_NVS_ENABLED=n
CONFIG_LWIP_MAX_SOCKETS=12

# The WebSocket (main/websocket.cpp). The upgrade request is built in the transport's buffer, and live
# voice's URL carries a token in its query: 4 KB, freed once the socket is open. Sends take a lock of
# their own, so a message being read (the core may hold the socket's task for a while) never holds
# up one being sent.
CONFIG_WS_BUFFER_SIZE=4096
CONFIG_WS_DYNAMIC_BUFFER=y
CONFIG_ESP_WS_CLIENT_SEPARATE_TX_LOCK=y
CONFIG_ESP_WS_CLIENT_TX_LOCK_TIMEOUT_MS=2000
